# Valeurs publiques utilisées par la PWA. La clé publishable est protégée par RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secrets réservés aux Supabase Edge Functions. Ne jamais préfixer par VITE_.
SOCIAL_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
SOCIAL_TOKEN_KEY_VERSION=1
ALLOWED_ORIGINS=http://127.0.0.1:1420,https://codescooper.github.io
