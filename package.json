{
  "name": "socialbrand-studio",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "version:check": "node scripts/check-versions.mjs",
    "pwa:check": "node scripts/check-pwa.mjs",
    "cloud:check": "node scripts/check-cloud.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "npm run version:check && npm run pwa:check && npm run cloud:check && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.5",
    "dexie": "4.4.4",
    "jszip": "3.10.1",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.8.2",
    "supabase": "2.109.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
